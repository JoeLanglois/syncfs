#!/bin/sh
set -eu

service={{ service }}.service
data_dir={{ data_dir }}
backup_dir={{ backup_dir }}
temporary="$backup_dir/synckv-data.tar.gz.tmp"
final="$backup_dir/synckv-data.tar.gz"
was_active=0

if systemctl is-active --quiet "$service"; then
    was_active=1
    systemctl stop "$service"
fi
restart() {
    rm -f "$temporary"
    if [ "$was_active" -eq 1 ]; then systemctl start "$service"; fi
}
trap restart EXIT INT TERM

tar --create --gzip --file "$temporary" --directory "$data_dir" .
chmod 0600 "$temporary"
mv -f "$temporary" "$final"

trap - EXIT INT TERM
if [ "$was_active" -eq 1 ]; then systemctl start "$service"; fi
